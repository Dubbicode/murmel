<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:models="using:Murmel.Models"
        mc:Ignorable="d" d:DesignWidth="980" d:DesignHeight="700"
        x:Class="Murmel.MainWindow"
        Width="980" Height="700"
        Background="{DynamicResource BgPage}"
        Icon="avares://Murmel/Assets/tray-icon.ico"
        Title="Murmel">

    <Grid ColumnDefinitions="64,*">

        <!-- ===================== SIDEBAR ===================== -->
        <Border Grid.Column="0" Background="{DynamicResource BgPanel}" BorderBrush="{DynamicResource BorderSubtle}"
                BorderThickness="0,0,1,0">
            <Grid RowDefinitions="Auto,*,Auto" Margin="0,20">
                <Border Grid.Row="0" Width="22" Height="22" CornerRadius="6" Background="{DynamicResource Accent}"
                        HorizontalAlignment="Center" Margin="0,0,0,24" />

                <StackPanel Grid.Row="1" Spacing="4" HorizontalAlignment="Center">
                    <Button Classes="navIconBtn navIconBtnActive" Name="TabRecorderBtn" Content="&#x2302;" ToolTip.Tip="Aufnahme" />
                    <Button Classes="navIconBtn" Name="TabHistoryBtn" Content="&#x1F550;" ToolTip.Tip="Verlauf" />
                    <Button Classes="navIconBtn" Name="TabDictionaryBtn" Content="&#x1F4D6;" ToolTip.Tip="Wörterbuch" />
                </StackPanel>

                <StackPanel Grid.Row="2" Spacing="4" HorizontalAlignment="Center">
                    <Button Classes="navIconBtn" Name="TabSettingsBtn" Content="&#x2699;" ToolTip.Tip="Einstellungen" />
                    <Button Classes="navIconBtn" Name="ThemeToggleBtn" Content="&#x263C;" ToolTip.Tip="Design wechseln" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===================== MAIN AREA ===================== -->
        <Grid Grid.Column="1" RowDefinitions="Auto,Auto,*">

            <!-- Status strip: small mic status + hotkey, replaces the old big record card -->
            <Border Grid.Row="0" Background="{DynamicResource BgPanel}" BorderBrush="{DynamicResource BorderSubtle}"
                    BorderThickness="0,0,0,1">
                <Grid ColumnDefinitions="Auto,*,Auto" Margin="20,10">
                    <Button Grid.Column="0" Classes="recordBtn" Name="RecordBtn" Content="&#x1F3A4;" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Name="StatusText" Text="Bereit" VerticalAlignment="Center" FontSize="12.5"
                               Foreground="{DynamicResource TextPrimary}" Margin="12,0,0,0" TextTrimming="CharacterEllipsis" />
                    <Border Grid.Column="2" Background="{DynamicResource BadgeNeutralBg}" BorderBrush="{DynamicResource BorderSubtle}"
                            BorderThickness="1" CornerRadius="6" Padding="10,5" VerticalAlignment="Center">
                        <TextBlock Name="HotkeyBadgeText" Text="STRG + SHIFT" FontSize="11" FontFamily="Consolas,monospace"
                                   Foreground="{DynamicResource TextSecondary}" />
                    </Border>
                </Grid>
            </Border>

            <ProgressBar Grid.Row="1" Name="ModelProgressBar" Minimum="0" Maximum="100" Height="3"
                         IsVisible="False" Foreground="{DynamicResource Accent}" />

            <!-- ===================== PAGE CONTAINER ===================== -->
            <Grid Grid.Row="2" Margin="20">

                <!-- Page: Recorder (home dashboard, Richtung H) -->
                <Grid Name="RecorderPage" ColumnDefinitions="1.3*,16,*" IsVisible="True">

                    <!-- Left column: Verlauf-Vorschau + Transkript -->
                    <Grid Grid.Column="0" RowDefinitions="*,16,*">
                        <Border Grid.Row="0" Background="{DynamicResource BgPanel}" BorderBrush="{DynamicResource BorderSubtle}"
                                BorderThickness="1" CornerRadius="16" Padding="18">
                            <Grid RowDefinitions="Auto,*">
                                <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,10">
                                    <TextBlock Grid.Column="0" Text="VERLAUF" FontSize="11" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextTertiary}" VerticalAlignment="Center" />
                                    <Button Grid.Column="1" Classes="ghost" Content="Alle →" Click="OnGoToHistoryClicked" />
                                </Grid>
                                <ScrollViewer Grid.Row="1">
                                    <ItemsControl Name="HistoryPreviewList">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid ColumnDefinitions="Auto,*" Margin="0,0,0,9">
                                                    <TextBlock Grid.Column="0" Text="{Binding DisplayTime}" FontSize="10.5"
                                                               FontFamily="Consolas,monospace" Foreground="{DynamicResource TextTertiary}"
                                                               VerticalAlignment="Top" Margin="0,1,10,0" />
                                                    <TextBlock Grid.Column="1" Text="{Binding Preview}" FontSize="12"
                                                               Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>
                        </Border>

                        <Border Grid.Row="2" Background="{DynamicResource BgPanel}" BorderBrush="{DynamicResource BorderSubtle}"
                                BorderThickness="1" CornerRadius="16" Padding="18">
                            <Grid RowDefinitions="Auto,*,Auto">
                                <TextBlock Grid.Row="0" Text="TRANSKRIPT" FontSize="11" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextTertiary}" Margin="0,0,0,10" />
                                <TextBox Grid.Row="1" Classes="editor" Name="TextEditor"
                                         Watermark="Dein transkribierter Text erscheint hier..." />
                                <StackPanel Grid.Row="2">
                                    <Border Height="1" Background="{DynamicResource BorderSoft}" Margin="0,10" />
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="20">
                                        <Button Classes="ghost" Name="CopyBtn" Content="Kopieren" />
                                        <Button Classes="ghost" Name="ClearBtn" Content="Löschen" />
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- Right column: Statistik + 7-Tage-Diagramm + Wörterbuch-Vorschau -->
                    <Grid Grid.Column="2" RowDefinitions="Auto,16,*,16,Auto">
                        <Border Grid.Row="0" Background="{DynamicResource BgPanel}" BorderBrush="{DynamicResource BorderSubtle}"
                                BorderThickness="1" CornerRadius="16" Padding="16">
                            <StackPanel Spacing="10">
                                <TextBlock Text="STATISTIK" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextTertiary}" />
                                <Grid ColumnDefinitions="*,*">
                                    <StackPanel Grid.Column="0" Spacing="2">
                                        <TextBlock Name="WordCountText" Text="0" FontSize="19" FontWeight="Bold"
                                                   FontFamily="Consolas,monospace" Foreground="{DynamicResource TextPrimary}" />
                                        <TextBlock Text="Heute" FontSize="10.5" Foreground="{DynamicResource TextTertiary}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Spacing="2">
                                        <TextBlock Name="TotalWordCountText" Text="0" FontSize="19" FontWeight="Bold"
                                                   FontFamily="Consolas,monospace" Foreground="{DynamicResource TextPrimary}" />
                                        <TextBlock Text="Insgesamt" FontSize="10.5" Foreground="{DynamicResource TextTertiary}" />
                                    </StackPanel>
                                </Grid>
                                <Border Height="1" Background="{DynamicResource BorderSoft}" />
                                <StackPanel Spacing="2">
                                    <TextBlock Name="LastRecordingText" Text="–" FontSize="12.5" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimary}" />
                                    <TextBlock Text="Letzte Aufnahme" FontSize="10.5" Foreground="{DynamicResource TextTertiary}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="2" Background="{DynamicResource BgPanel}" BorderBrush="{DynamicResource BorderSubtle}"
                                BorderThickness="1" CornerRadius="16" Padding="16">
                            <StackPanel Spacing="8">
                                <TextBlock Text="LETZTE 7 TAGE" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextTertiary}" />
                                <Canvas Name="WeekChartCanvas" Height="70" HorizontalAlignment="Stretch">
                                    <Polyline Name="WeekChartLine" Stroke="{DynamicResource Accent}" StrokeThickness="2"
                                              StrokeLineCap="Round" StrokeJoin="Round" />
                                    <Ellipse Name="DayDot0" Width="7" Height="7" Fill="{DynamicResource Accent}" />
                                    <Ellipse Name="DayDot1" Width="7" Height="7" Fill="{DynamicResource Accent}" />
                                    <Ellipse Name="DayDot2" Width="7" Height="7" Fill="{DynamicResource Accent}" />
                                    <Ellipse Name="DayDot3" Width="7" Height="7" Fill="{DynamicResource Accent}" />
                                    <Ellipse Name="DayDot4" Width="7" Height="7" Fill="{DynamicResource Accent}" />
                                    <Ellipse Name="DayDot5" Width="7" Height="7" Fill="{DynamicResource Accent}" />
                                    <Ellipse Name="DayDot6" Width="7" Height="7" Fill="{DynamicResource Accent}" />
                                    <TextBlock Name="DayCount0" Text="0" FontSize="10.5" FontFamily="Consolas,monospace" FontWeight="Bold" Foreground="{DynamicResource Accent}" />
                                    <TextBlock Name="DayCount1" Text="0" FontSize="10.5" FontFamily="Consolas,monospace" FontWeight="Bold" Foreground="{DynamicResource Accent}" />
                                    <TextBlock Name="DayCount2" Text="0" FontSize="10.5" FontFamily="Consolas,monospace" FontWeight="Bold" Foreground="{DynamicResource Accent}" />
                                    <TextBlock Name="DayCount3" Text="0" FontSize="10.5" FontFamily="Consolas,monospace" FontWeight="Bold" Foreground="{DynamicResource Accent}" />
                                    <TextBlock Name="DayCount4" Text="0" FontSize="10.5" FontFamily="Consolas,monospace" FontWeight="Bold" Foreground="{DynamicResource Accent}" />
                                    <TextBlock Name="DayCount5" Text="0" FontSize="10.5" FontFamily="Consolas,monospace" FontWeight="Bold" Foreground="{DynamicResource Accent}" />
                                    <TextBlock Name="DayCount6" Text="0" FontSize="10.5" FontFamily="Consolas,monospace" FontWeight="Bold" Foreground="{DynamicResource Accent}" />
                                </Canvas>
                                <Grid ColumnDefinitions="*,*,*,*,*,*,*">
                                    <TextBlock Grid.Column="0" Name="DayLabel0" Text="Mo" FontSize="10" HorizontalAlignment="Center" Foreground="{DynamicResource TextTertiary}" />
                                    <TextBlock Grid.Column="1" Name="DayLabel1" Text="Di" FontSize="10" HorizontalAlignment="Center" Foreground="{DynamicResource TextTertiary}" />
                                    <TextBlock Grid.Column="2" Name="DayLabel2" Text="Mi" FontSize="10" HorizontalAlignment="Center" Foreground="{DynamicResource TextTertiary}" />
                                    <TextBlock Grid.Column="3" Name="DayLabel3" Text="Do" FontSize="10" HorizontalAlignment="Center" Foreground="{DynamicResource TextTertiary}" />
                                    <TextBlock Grid.Column="4" Name="DayLabel4" Text="Fr" FontSize="10" HorizontalAlignment="Center" Foreground="{DynamicResource TextTertiary}" />
                                    <TextBlock Grid.Column="5" Name="DayLabel5" Text="Sa" FontSize="10" HorizontalAlignment="Center" Foreground="{DynamicResource TextTertiary}" />
                                    <TextBlock Grid.Column="6" Name="DayLabel6" Text="So" FontSize="10" HorizontalAlignment="Center" Foreground="{DynamicResource TextTertiary}" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="4" Background="{DynamicResource BgPanel}" BorderBrush="{DynamicResource BorderSubtle}"
                                BorderThickness="1" CornerRadius="16" Padding="16">
                            <StackPanel Spacing="10">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Grid.Column="0" Text="WÖRTERBUCH" FontSize="11" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextTertiary}" VerticalAlignment="Center" />
                                    <Button Grid.Column="1" Classes="ghost" Content="Bearbeiten →" Click="OnGoToDictionaryClicked" />
                                </Grid>
                                <ItemsControl Name="DictionaryPreviewList">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{DynamicResource BadgeNeutralBg}" CornerRadius="999" Padding="9,5" Margin="0,0,6,6">
                                                <TextBlock Text="{Binding Trigger}" FontSize="10.5" Foreground="{DynamicResource TextSecondary}" />
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>

                <!-- Page: History -->
                <Grid Name="HistoryPage" RowDefinitions="Auto,Auto,*" IsVisible="False">
                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,14">
                        <TextBlock Grid.Column="0" Text="Verlauf" FontSize="22" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimary}" />
                        <Button Grid.Column="1" Classes="ghost" Name="ClearHistoryBtn" Content="Verlauf leeren" />
                    </Grid>
                    <TextBox Grid.Row="1" Name="HistorySearchBox" Watermark="Verlauf durchsuchen…" Margin="0,0,0,16" />
                    <TextBlock Grid.Row="2" Name="HistoryEmptySearchText" Text="Keine Treffer" IsVisible="False"
                               Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Center" Margin="0,20,0,0" />
                    <ScrollViewer Grid.Row="2">
                        <ItemsControl Name="HistoryList">
                            <ItemsControl.DataTemplates>
                                <DataTemplate DataType="models:HistoryDateHeader">
                                    <TextBlock Text="{Binding Label}" FontSize="12.5" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextTertiary}" Margin="2,14,0,8" />
                                </DataTemplate>
                                <DataTemplate DataType="models:HistoryEntry">
                                    <Border Background="{DynamicResource BgPanel}" BorderBrush="{DynamicResource BorderSubtle}"
                                            BorderThickness="1" CornerRadius="12" Padding="16,12" Margin="0,0,0,8">
                                        <Grid ColumnDefinitions="Auto,*,Auto">
                                            <TextBlock Grid.Column="0" Text="{Binding DisplayTime}"
                                                       Foreground="{DynamicResource TextTertiary}"
                                                       FontSize="12" VerticalAlignment="Top" Margin="0,0,16,0" />
                                            <!-- SelectableTextBlock (not TextBlock) so the full dictated
                                                 text can be selected/dragged and copied with Ctrl+C. -->
                                            <SelectableTextBlock Grid.Column="1" Text="{Binding Text}"
                                                       Foreground="{DynamicResource TextPrimary}"
                                                       TextWrapping="Wrap" />
                                            <Button Grid.Column="2" Classes="ghost" Content="Kopieren"
                                                    Tag="{Binding}" Click="OnHistoryItemCopyClicked"
                                                    VerticalAlignment="Top" Margin="12,0,0,0" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.DataTemplates>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>

                <!-- Page: Dictionary -->
                <ScrollViewer Name="DictionaryPage" IsVisible="False">
                    <StackPanel Spacing="20" Margin="0,0,12,0">
                        <TextBlock Text="Wörterbuch" FontSize="22" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimary}" />

                        <!-- Corrections -->
                        <Border Background="{DynamicResource BgPanel}" BorderBrush="{DynamicResource BorderSubtle}"
                                BorderThickness="1" CornerRadius="12" Padding="18">
                            <StackPanel Spacing="14">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="Korrekturen" FontWeight="Medium" Foreground="{DynamicResource TextPrimary}" />
                                    <TextBlock Text="Wörter, die die Spracherkennung öfter falsch versteht — werden automatisch ersetzt."
                                               FontSize="12" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" />
                                </StackPanel>

                                <ItemsControl Name="CorrectionsList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid ColumnDefinitions="*,Auto,*,Auto" Margin="0,0,0,6">
                                                <Border Grid.Column="0" Background="{DynamicResource BgPage}" CornerRadius="8" Padding="10,7">
                                                    <TextBox Text="{Binding Wrong, Mode=TwoWay}" Background="Transparent" BorderThickness="0"
                                                             Padding="0" MinHeight="0" Foreground="{DynamicResource TextPrimary}"
                                                             LostFocus="OnDictionaryFieldEdited" />
                                                </Border>
                                                <TextBlock Grid.Column="1" Text="→" Margin="10,0" VerticalAlignment="Center"
                                                           Foreground="{DynamicResource TextTertiary}" />
                                                <Border Grid.Column="2" Background="{DynamicResource BgPage}" CornerRadius="8" Padding="10,7">
                                                    <TextBox Text="{Binding Right, Mode=TwoWay}" Background="Transparent" BorderThickness="0"
                                                             Padding="0" MinHeight="0" Foreground="{DynamicResource TextPrimary}"
                                                             LostFocus="OnDictionaryFieldEdited" />
                                                </Border>
                                                <Button Grid.Column="3" Classes="ghost" Content="Entfernen" Margin="10,0,0,0"
                                                        Tag="{Binding}" Click="OnRemoveCorrectionClicked" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <Border Height="1" Background="{DynamicResource BorderSoft}" />

                                <Grid ColumnDefinitions="*,Auto,*,Auto">
                                    <TextBox Grid.Column="0" Name="NewCorrectionWrongBox" Watermark="wird falsch erkannt als…" />
                                    <TextBlock Grid.Column="1" Text="→" Margin="10,0" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextTertiary}" />
                                    <TextBox Grid.Column="2" Name="NewCorrectionRightBox" Watermark="richtige Schreibweise" />
                                    <Button Grid.Column="3" Classes="ghost" Content="Hinzufügen" Margin="10,0,0,0" Name="AddCorrectionBtn" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Snippets -->
                        <Border Background="{DynamicResource BgPanel}" BorderBrush="{DynamicResource BorderSubtle}"
                                BorderThickness="1" CornerRadius="12" Padding="18">
                            <StackPanel Spacing="14">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="Sprach-Snippets" FontWeight="Medium" Foreground="{DynamicResource TextPrimary}" />
                                    <TextBlock Text="Sag den Auslöser + &quot;einfügen&quot;/&quot;hinzufügen&quot; (z.B. &quot;meine E-Mail hinzufügen&quot;), Murmel fügt stattdessen den hinterlegten Text ein. Mehrere Auslöser für denselben Text? Einfach mit Komma trennen (z.B. &quot;meine Handynummer, meine Telefonnummer&quot;)."
                                               FontSize="12" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" />
                                </StackPanel>

                                <ItemsControl Name="SnippetsList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid ColumnDefinitions="*,Auto,*,Auto" Margin="0,0,0,6">
                                                <Border Grid.Column="0" Background="{DynamicResource BgPage}" CornerRadius="8" Padding="10,7">
                                                    <TextBox Text="{Binding Trigger, Mode=TwoWay}" Background="Transparent" BorderThickness="0"
                                                             Padding="0" MinHeight="0" Foreground="{DynamicResource TextPrimary}"
                                                             LostFocus="OnDictionaryFieldEdited" />
                                                </Border>
                                                <TextBlock Grid.Column="1" Text="→" Margin="10,0" VerticalAlignment="Center"
                                                           Foreground="{DynamicResource TextTertiary}" />
                                                <Border Grid.Column="2" Background="{DynamicResource BgPage}" CornerRadius="8" Padding="10,7">
                                                    <TextBox Text="{Binding Value, Mode=TwoWay}" Background="Transparent" BorderThickness="0"
                                                             Padding="0" MinHeight="0" Foreground="{DynamicResource TextPrimary}"
                                                             LostFocus="OnDictionaryFieldEdited" />
                                                </Border>
                                                <Button Grid.Column="3" Classes="ghost" Content="Entfernen" Margin="10,0,0,0"
                                                        Tag="{Binding}" Click="OnRemoveSnippetClicked" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <Border Height="1" Background="{DynamicResource BorderSoft}" />

                                <Grid ColumnDefinitions="*,Auto,*,Auto">
                                    <TextBox Grid.Column="0" Name="NewSnippetTriggerBox" Watermark="Auslöser, z.B. meine E-Mail, meine Mailadresse" />
                                    <TextBlock Grid.Column="1" Text="→" Margin="10,0" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextTertiary}" />
                                    <TextBox Grid.Column="2" Name="NewSnippetValueBox" Watermark="einzufügender Text" />
                                    <Button Grid.Column="3" Classes="ghost" Content="Hinzufügen" Margin="10,0,0,0" Name="AddSnippetBtn" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- Page: Settings -->
                <StackPanel Name="SettingsPage" IsVisible="False" Spacing="20">
                    <TextBlock Text="Einstellungen" FontSize="22" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,8" />

                    <Border Background="{DynamicResource BgPanel}" BorderBrush="{DynamicResource BorderSubtle}"
                            BorderThickness="1" CornerRadius="12" Padding="18">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Spacing="2">
                                <TextBlock Text="Hotkey" FontWeight="Medium"
                                           Foreground="{DynamicResource TextPrimary}" />
                                <TextBlock Text="Kombination halten = aufnehmen, loslassen = einfügen"
                                           FontSize="12" Foreground="{DynamicResource TextSecondary}" />
                            </StackPanel>
                            <ComboBox Grid.Column="1" Name="HotkeyPresetCombo" MinWidth="160" />
                        </Grid>
                    </Border>

                    <Border Background="{DynamicResource BgPanel}" BorderBrush="{DynamicResource BorderSubtle}"
                            BorderThickness="1" CornerRadius="12" Padding="18">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Spacing="2">
                                <TextBlock Text="Umschalt-Modus statt Halten" FontWeight="Medium"
                                           Foreground="{DynamicResource TextPrimary}" />
                                <TextBlock Text="Hotkey einmal drücken startet die Aufnahme, nochmal drücken stoppt sie — du musst die Taste nicht mehr gedrückt halten"
                                           FontSize="12" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" Name="RecordingModeToggle" IsChecked="False"
                                          OnContent="" OffContent="" />
                        </Grid>
                    </Border>

                    <Border Background="{DynamicResource BgPanel}" BorderBrush="{DynamicResource BorderSubtle}"
                            BorderThickness="1" CornerRadius="12" Padding="18">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Spacing="2">
                                <TextBlock Text="Automatisch ins aktive Fenster einfügen" FontWeight="Medium"
                                           Foreground="{DynamicResource TextPrimary}" />
                                <TextBlock Text="Text wird direkt dort eingefügt, wo dein Cursor gerade ist — kein Copy/Paste nötig"
                                           FontSize="12" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" Name="AutoPasteToggle" IsChecked="True"
                                          OnContent="" OffContent="" />
                        </Grid>
                    </Border>

                    <Border Background="{DynamicResource BgPanel}" BorderBrush="{DynamicResource BorderSubtle}"
                            BorderThickness="1" CornerRadius="12" Padding="18">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Spacing="2">
                                <TextBlock Text="Mit Windows starten" FontWeight="Medium"
                                           Foreground="{DynamicResource TextPrimary}" />
                                <TextBlock Text="Murmel startet dann automatisch im Hintergrund, wenn du dich bei Windows anmeldest — keine Installation nötig."
                                           FontSize="12" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" Name="AutostartToggle" IsChecked="False"
                                          OnContent="" OffContent="" />
                        </Grid>
                    </Border>

                    <Border Background="{DynamicResource BgPanel}" BorderBrush="{DynamicResource BorderSubtle}"
                            BorderThickness="1" CornerRadius="12" Padding="18">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Spacing="2">
                                <TextBlock Text="Hintergrund-Widget" FontWeight="Medium"
                                           Foreground="{DynamicResource TextPrimary}" />
                                <TextBlock Text="Der kleine Balken lässt sich direkt auf dem Bildschirm per Ziehen verschieben."
                                           FontSize="12" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" />
                            </StackPanel>
                            <Button Grid.Column="1" Classes="ghost" Name="ResetIndicatorPositionBtn" Content="Position zurücksetzen" />
                        </Grid>
                    </Border>

                    <Border Background="{DynamicResource BgPanel}" BorderBrush="{DynamicResource BorderSubtle}"
                            BorderThickness="1" CornerRadius="12" Padding="18">
                        <StackPanel Spacing="2">
                            <TextBlock Text="Mikrofon" FontWeight="Medium" Foreground="{DynamicResource TextPrimary}" />
                            <TextBlock Text="Standard-Mikrofon von Windows (Auswahl einzelner Geräte folgt später)"
                                       FontSize="12" Foreground="{DynamicResource TextSecondary}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>
