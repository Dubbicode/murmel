<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Murmel.App"
             RequestedThemeVariant="Default">

    <TrayIcon.Icons>
        <TrayIcons>
            <TrayIcon Icon="avares://Murmel/Assets/tray-icon.ico" ToolTipText="Murmel — läuft im Hintergrund">
                <TrayIcon.Menu>
                    <NativeMenu>
                        <NativeMenuItem Header="Fenster öffnen" Click="OnTrayShowClicked" />
                        <NativeMenuItemSeparator />
                        <NativeMenuItem Header="Beenden" Click="OnTrayExitClicked" />
                    </NativeMenu>
                </TrayIcon.Menu>
            </TrayIcon>
        </TrayIcons>
    </TrayIcon.Icons>

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <!-- Tokens match the approved "Murmel UI Entwurf" design canvas, Richtung H
                     (Icon-Seitenleiste + Kachel-Raster): warm near-black dark theme with an
                     amber accent, plus a matching warm-neutral light theme (same accent). -->
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="BgPage">#FAF8F4</SolidColorBrush>
                    <SolidColorBrush x:Key="BgPanel">#FFFFFF</SolidColorBrush>
                    <SolidColorBrush x:Key="TextPrimary">#201D18</SolidColorBrush>
                    <SolidColorBrush x:Key="TextSecondary">#6E685D</SolidColorBrush>
                    <SolidColorBrush x:Key="TextTertiary">#9C9689</SolidColorBrush>
                    <SolidColorBrush x:Key="BorderSubtle">#E8E1D3</SolidColorBrush>
                    <SolidColorBrush x:Key="BorderSoft">#F1ECE1</SolidColorBrush>
                    <SolidColorBrush x:Key="PlaceholderColor">#B0A996</SolidColorBrush>
                    <SolidColorBrush x:Key="BadgeNeutralBg">#F3EEE5</SolidColorBrush>
                    <SolidColorBrush x:Key="BadgeAccentBg">#FBF0D9</SolidColorBrush>
                    <SolidColorBrush x:Key="BadgeAccentText">#A6710A</SolidColorBrush>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="BgPage">#0E0D0C</SolidColorBrush>
                    <SolidColorBrush x:Key="BgPanel">#171513</SolidColorBrush>
                    <SolidColorBrush x:Key="TextPrimary">#F4F0EA</SolidColorBrush>
                    <SolidColorBrush x:Key="TextSecondary">#A29A8E</SolidColorBrush>
                    <SolidColorBrush x:Key="TextTertiary">#6D665C</SolidColorBrush>
                    <SolidColorBrush x:Key="BorderSubtle">#2A2621</SolidColorBrush>
                    <SolidColorBrush x:Key="BorderSoft">#221F1B</SolidColorBrush>
                    <SolidColorBrush x:Key="PlaceholderColor">#6D665C</SolidColorBrush>
                    <SolidColorBrush x:Key="BadgeNeutralBg">#1E1B18</SolidColorBrush>
                    <SolidColorBrush x:Key="BadgeAccentBg">#F0B4291F</SolidColorBrush>
                    <SolidColorBrush x:Key="BadgeAccentText">#F7C95C</SolidColorBrush>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <!-- Accent: Amber, as chosen for the project (Richtung H) - same in both themes -->
            <SolidColorBrush x:Key="Accent">#F0B429</SolidColorBrush>
            <SolidColorBrush x:Key="AccentHover">#D99A1F</SolidColorBrush>
            <SolidColorBrush x:Key="AccentSoft">#F0B42922</SolidColorBrush>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />

        <!-- Record button: small solid accent circle, sitting in the status strip rather
             than being the page's centerpiece (Richtung H - hotkey is the primary way to
             record, this is just a status indicator + fallback click target). Dark icon
             on the amber fill reads better than white. -->
        <Style Selector="Button.recordBtn">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="CornerRadius" Value="15" />
            <Setter Property="Background" Value="{DynamicResource Accent}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="#171513" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.15" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.recordBtn:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentHover}" />
        </Style>
        <Style Selector="Button.recordBtn.isRecording">
            <Setter Property="Background" Value="{DynamicResource AccentHover}" />
        </Style>

        <!-- Sidebar icon-only nav buttons (replaces the old top tab bar) -->
        <Style Selector="Button.navIconBtn">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="40" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource TextTertiary}" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.navIconBtn:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource BorderSoft}" />
        </Style>
        <Style Selector="Button.navIconBtn:pointerover">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        </Style>
        <Style Selector="Button.navIconBtnActive">
            <Setter Property="Background" Value="{DynamicResource BadgeAccentBg}" />
            <Setter Property="Foreground" Value="{DynamicResource BadgeAccentText}" />
        </Style>
        <Style Selector="Button.navIconBtnActive:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource BadgeAccentBg}" />
        </Style>

        <!-- Borderless text editor - sits directly inside the transcript card, which
             already provides the panel background and border. -->
        <Style Selector="TextBox.editor">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="AcceptsReturn" Value="True" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <!-- Ghost / secondary action buttons -->
        <Style Selector="Button.ghost">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
            <Setter Property="Padding" Value="4,4" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="Button.ghost:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource BorderSoft}" />
        </Style>

        <!-- Tiny icon-only buttons on a Notizen tile (bearbeiten / erledigt) and in a
             board column header (Projekt entfernen). -->
        <Style Selector="Button.tileIconBtn">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.tileIconBtn:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource BorderSoft}" />
        </Style>

    </Application.Styles>
</Application>
